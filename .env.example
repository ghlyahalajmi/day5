# Copy this file to `.env.local` and fill in your own Supabase values.
# Supabase dashboard -> Project Settings -> API Keys

# Your project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The PUBLISHABLE key (starts with `sb_publishable_`).
# This one is safe in the browser because Row Level Security guards the data.
# Never put the secret / service-role key in this project.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
